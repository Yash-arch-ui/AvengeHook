# RPC endpoint (HTTP or WebSocket)
RPC_URL=http://127.0.0.1:8545

# AvengeHook contract address
# Live Arbitrum Sepolia deployment
HOOK_ADDRESS=0xf53c43858D62a1765480508f3bE7481e883380A8

# Pyth oracle address
# Arbitrum Sepolia: 0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF
PYTH_ADDRESS=0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF

# Hermes API key for `keeper` (free trial at https://pythdata.app)
# PYTH_API_KEY=

# Chain ID (421614 = Arbitrum Sepolia)
CHAIN_ID=421614

# Path to Foundry project (avenge-hook/packages/foundry)
# Leave empty to auto-detect from workspace root
# FORGE_DIR=/path/to/avenge-hook/packages/foundry

# Pool ID (bytes32) used by `state` for per-pool accumulator reads
# Default: live ETH/USDC Pool 1 — dynamic fee 8388608, tickSpacing 30, 2500 USDC/ETH
POOL_ID=0x5771f78e1245220ba528309807e28c9bad50849292b2a694ffba8958196c9c4b

# USDC token (currency1 of the default ETH/USDC pool)
USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# Pool key used by `simulate` (must match the pool you want to quote)
# Defaults below match POOL_ID above; override for other pools
#CURRENCY0=0x0000000000000000000000000000000000000000
#CURRENCY1=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
#POOL_FEE=8388608  # dynamic-fee pool
#TICK_SPACING=30
#CURRENCY0_DECIMALS=18
#CURRENCY1_DECIMALS=6

# Private key for deployment (only needed for deploy command)
DEPLOYMENT_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
