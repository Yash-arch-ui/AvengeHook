# RPC endpoint (HTTP or WebSocket)
RPC_URL=http://127.0.0.1:8545

# DetoxHook contract address (after deployment)
HOOK_ADDRESS=0x0000000000000000000000000000000000000000

# Pyth oracle address
# Arbitrum Sepolia: 0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF
PYTH_ADDRESS=0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF

# Chain ID (421614 = Arbitrum Sepolia)
CHAIN_ID=421614

# Path to Foundry project (detox-hook/packages/foundry)
# Leave empty to auto-detect from workspace root
# FORGE_DIR=/path/to/detox-hook/packages/foundry

# Private key for deployment (only needed for deploy command)
DEPLOYMENT_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
